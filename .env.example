# Copiá este archivo como .env y completalo. El .env nunca se sube a git.

# FreeLLMAPI de escritorio (API compatible con OpenAI). La clave se lee sola de ~/.freellmapi-key
FREELLMAPI_URL=http://127.0.0.1:31416/v1
# FREELLMAPI_KEY=freellmapi-...
# Modelos para escribir, en orden de preferencia (si uno falla usa el siguiente)
# MORTLINE_MODELOS=gemini-3.8-flash,deepseek-v4-pro,glm-5.3,auto

# GGNarrator (tu deploy en Cloud Run). Ej: https://ggnarrator-XXXX.us-east1.run.app
GGNARRATOR_URL=
# Voz por defecto: Puck, Fenrir, Charon, Kore o Zephyr
MORTLINE_VOZ=Puck

# Clips: con clave de Pixabay salen videos HD; sin clave usa fotos libres (CC0) de Openverse.
# Clave gratis: https://pixabay.com/api/docs/ (aparece logueado, en "Parameters > key")
PIXABAY_API_KEY=
# PEXELS_API_KEY=

# Datos de la placa final
MORTLINE_WHATSAPP=+54 9 2634 279451
MORTLINE_WEB=mortups.com.ar

# Dónde se guardan los reels
MORTLINE_SALIDA=~/Videos/mortline
